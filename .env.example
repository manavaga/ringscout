# RingScout Environment Template (Copy to .env for local non-Secret-Manager dev; NEVER commit real keys)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Production secrets are mounted automatically from Google Cloud Secret Manager via ./scripts/setup_gcp_secrets.sh
RINGSCOUT_USE_SECRET_MANAGER=1
RINGSCOUT_PUBLIC_CONSUMER_ACCESS=1

# Optional Phase B Agent Monetization (x402 USDC / Stripe MPP)
RINGSCOUT_PAYMENT_GATE_MODE=off
X402_PAY_TO_ADDRESS=0xYourMerchantBaseWalletAddress
STRIPE_CHECKOUT_URL=

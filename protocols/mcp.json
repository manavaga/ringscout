  "version": "3.0.0",
  "websiteUrl": "https://ringscout-hom7ntreuq-uc.a.run.app",
  "repository": {
    "url": "https://github.com/manavaga/ringscout",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://ringscout-hom7ntreuq-uc.a.run.app/mcp",
      "supportedProtocolVersions": ["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"]
